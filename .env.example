# Local dev config for the banking portal stack.
# Copy to .env and fill in every value. Never commit the filled-in file.

HTTP_PORT=80
HTTPS_PORT=443

# HMAC key for signed /api/updates calls. Must match the staging key or
# every signed request comes back 403. Ask infra, don't copy it off a host.
INTERNAL_API_SECRET=
SESSION_SECRET=

# Local portal sign-in. Use throwaway values for a dev box.
PORTAL_USERNAME=
PORTAL_PASSWORD=
COOKIE_SECURE=false

POSTGRES_DB=bellwood
POSTGRES_USER=bellwood_admin
POSTGRES_PASSWORD=
APP_DB_USER=bellwood_app
APP_DB_PASSWORD=
